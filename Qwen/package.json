{
  "name": "dsh-qwen",
  "version": "0.2.2",
  "description": "Qwen Chat Completions provider for DSH 0.2.1-rc.2 with gateway aliases, thinking modes and native replay",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./lib/index.js",
    "./catalog": "./lib/catalog.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "scripts/test-runtime.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test --test-isolation=none test/*.test.mjs",
    "prepack": "npm run typecheck && npm run build",
    "test:runtime": "node scripts/test-runtime.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "3.18.5",
    "@earendil-works/pi-ai": "1.1.0",
    "@deepseek-ai/dsh-launch-environment": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
