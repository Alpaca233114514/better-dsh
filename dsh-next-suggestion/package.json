{
  "name": "dsh-next-suggestion",
  "version": "0.5.0",
  "private": true,
  "description": "Next-message suggestions for the DeepSeek Harness composer: ghost text, Tab to accept.",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "composer"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./typert": "./lib/typert.host.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/host-harness.mjs && node test/client-harness.mjs && node --test test/runtime-harness.mjs test/install-harness.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "zod": ">=3.25 <5"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.3.0-0",
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.5",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@deepseek-ai/dsh-llm": {
      "zod": "$zod"
    }
  }
}
