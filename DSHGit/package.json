{
  "name": "dshgit",
  "version": "0.1.5",
  "description": "DSHGit — native Git changes, commit, push and pull request panel for DSH",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/cordis": "4.0.5-alpha.1 || 4.0.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-alpha.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-alpha.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-alpha.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.1-alpha.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "jsdom": "26.1.0",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2"
  }
}
