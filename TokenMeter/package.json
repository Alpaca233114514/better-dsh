  "scripts": { "build": "node scripts/build.mjs", "test": "node --test test/*.test.mjs", "pack:desktop": "node scripts/pack-desktop.mjs" },
  "dependencies": { "zod": "4.6.6" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4 || 4.0.5-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "react": "^18.3.1"
  },
  "devDependencies": { "esbuild": "0.25.12" }
}
