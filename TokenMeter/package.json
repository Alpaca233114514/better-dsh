{
  "name": "dsh-token-meter-dashboard",
  "version": "0.2.0",
  "description": "Persistent Token Meter dashboard for DeepSeek Harness desktop",
  "type": "module",
  "license": "Apache-2.0",
  "exports": { ".": "./lib/host.js", "./client": "./lib/client.js" },
  "files": ["lib", "cordis.patch.yml", "README.md", "DESKTOP.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-api-gateway", "@deepseek-ai/dsh-client-ui-settings"] }
